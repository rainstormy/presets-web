{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@rainstormy/presets-web",
	"version": "1.0.0-rc.2",
	"description": "Predefined, opinionated configurations for Oxfmt, Oxlint, and TypeScript, with add-ons for Next.js, React Router, Storybook, and Vitest.",
	"keywords": [
		"configs",
		"format",
		"lint",
		"oxc",
		"oxfmt",
		"oxlint",
		"typescript"
	],
	"bugs": "https://github.com/rainstormy/presets-web/issues",
	"license": "MIT",
	"author": "Steffen Diswal",
	"repository": {
		"type": "git",
		"url": "https://github.com/rainstormy/presets-web.git"
	},
	"files": [
		"dist/"
	],
	"type": "module",
	"imports": {
		"#oxfmt/*": "./src/oxfmt/*",
		"#oxlint/*": "./src/oxlint/*",
		"#utilities/*": "./src/utilities/*"
	},
	"exports": {
		"./oxfmt": {
			"import": "./dist/oxfmt/index.js",
			"types": "./dist/oxfmt/index.d.ts"
		},
		"./oxlint": {
			"import": "./dist/oxlint/index.js",
			"types": "./dist/oxlint/index.d.ts"
		},
		"./typescript": "./dist/typescript/index.json"
	},
	"dependencies": {
		"oxlint-tsgolint": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"lefthook": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"typescript": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"oxfmt": "^0.60.0",
		"oxlint": "^1.75.0",
		"typescript": "^7.0.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.17.0",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "24.19.0",
			"onFail": "download"
		}
	}
}
